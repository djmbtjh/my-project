# ==============================================================================
# 賽博闖關戰 (Cyber Quiz) - 環境變數設定範本 (.env.example)
# 使用方式：複製本檔案為 .env 並填入實際數值
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# Google Apps Script 部署後的 Web 應用程式網址 (Web App URL)
# 注意：部署時「誰可以存取 (Who has access)」務必選擇「所有人 (Anyone)」
# 若留空，系統將自動啟動內建的單機模擬器進行測試
GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# 通過門檻（需要答對幾題才算通過遊戲並計入通關紀錄）
PASS_THRESHOLD=6
VITE_PASS_THRESHOLD=6

# 每次遊戲隨機撈取的關卡題目數量
QUESTION_COUNT=10
VITE_QUESTION_COUNT=10
